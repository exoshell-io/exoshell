{
  "[css][graphql][html][javascript][javascriptreact][json][jsonc][markdown][mdx][scss][typescript][typescriptreact][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cSpell.words": [
    "aarch",
    "appimage",
    "appindicator",
    "appshell",
    "azuretools",
    "bierner",
    "bradlc",
    "clippy",
    "clsx",
    "contextmenu",
    "dbaeumer",
    "DEVCONTAINER",
    "Dismissable",
    "eamodio",
    "esbenp",
    "euxo",
    "exoshell",
    "exoshelld",
    "formulahendry",
    "foxundermoon",
    "fttemplates",
    "getent",
    "gosu",
    "GROUPNAME",
    "hoovercj",
    "Huuums",
    "libayatana",
    "libgtk",
    "librsvg",
    "libwebkit",
    "lintstargedrc",
    "lockb",
    "mantine",
    "meganrogge",
    "naumovs",
    "nodrag",
    "nonblock",
    "noprofile",
    "norc",
    "nprogress",
    "nsis",
    "nullglob",
    "oklch",
    "pangea",
    "pascalcase",
    "patchelf",
    "pidlock",
    "pipefail",
    "pkgs",
    "posthog",
    "proto",
    "protoc",
    "protos",
    "quickbar",
    "reactflow",
    "rolldown",
    "rsplit",
    "rustc",
    "rustup",
    "serayuzgur",
    "shadcn",
    "shellcheck",
    "Shiki",
    "shikijs",
    "sysinfo",
    "tailwindcss",
    "tamasfe",
    "tanstack",
    "tauri",
    "thiserror",
    "timonwong",
    "twoslash",
    "unocss",
    "usermod",
    "vunguyentuan",
    "webext",
    "webstore",
    "yatki"
  ],
  "cssVariables.lookupFiles": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "node_modules/@mantine/core/styles.css"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.tabSize": 2,
  "files.associations": {
    "**/*.json": "jsonc",
    "**/package.json": "json",
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "json.schemas": [
    {
      "fileMatch": ["manifest.json"],
      "url": "https://json.schemastore.org/chrome-manifest"
    }
  ],
  "rust-analyzer.check.command": "clippy",
  "search.exclude": {
    "**/*.code-search": true,
    "**/_next": true,
    "**/bower_components": true,
    "**/node_modules": true,
    "**/.*": true,
    ".github": false,
    "**/*.tsbuildinfo": true
  },
  "turbo.path": "node_modules/turbo/bin/turbo",
  "turbo.useLocalTurbo": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "github.copilot.editor.enableAutoCompletions": true,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "cSpell.enabledFileTypes": {
    "Dockerfile": true
  },
  "tailwindCSS.experimental.classRegex": [
    ["([\"'`][^\"'`]*.*?[\"'`])", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ]
}
