{
  "name": "@exoshell/browser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build:",
    "build:": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt zip -b chrome",
    "build:firefox": "wxt zip -b firefox",
    "clean": "rm -rf -- .output/ .wxt/ tsconfig.tsbuildinfo",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "lint": "turbo run lint:",
    "lint:": "eslint --max-warnings=0",
    "release": "bun run release:chrome && bun run release:firefox",
    "release:chrome": "sh _scripts/publish-chrome.sh",
    "release:firefox": "sh _scripts/publish-firefox.sh"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "1.0.2",
    "@wxt-dev/module-react": "1.1.2",
    "wxt": "0.19.16"
  }
}
