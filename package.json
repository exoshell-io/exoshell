{
  "name": "@exoshell/root",
  "private": true,
  "type": "module",
  "workspaces": [
    ".github/scripts",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo run build:",
    "ci": "bun run format:check && bun run gen:types && bun run lint && bun run test",
    "clean": "turbo run clean",
    "format": "prettier -w . ; sort-package-json",
    "format:check": "prettier --check . && sort-package-json --check && cargo fmt --check",
    "gen:types": "rm -rf libs/model/types/ && cargo test -p model export_bindings",
    "lint": "turbo run lint: && cargo clippy",
    "prepare": "husky",
    "test": "turbo run test && cargo test --locked",
    "update": "bun x npm-check-updates -ui -ws --root"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true
  },
  "dependencies": {
    "@hello-pangea/dnd": "17.0.0",
    "@mantine/code-highlight": "7.14.1",
    "@mantine/core": "7.14.1",
    "@mantine/dropzone": "7.14.1",
    "@mantine/form": "7.14.1",
    "@mantine/hooks": "7.14.1",
    "@mantine/modals": "7.14.1",
    "@mantine/notifications": "7.14.1",
    "@mantine/nprogress": "7.14.1",
    "@mantine/spotlight": "7.14.1",
    "@monaco-editor/react": "4.6.0",
    "@tanstack/query-core": "5.60.6",
    "@tanstack/react-query": "5.60.6",
    "@tanstack/react-router": "1.82.1",
    "@tanstack/router-devtools": "1.82.1",
    "@tanstack/router-plugin": "1.81.9",
    "@vercel/postgres": "0.10.0",
    "allotment": "1.20.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.3",
    "jotai": "2.10.2",
    "mantine-contextmenu": "7.12.2",
    "next": "15.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "react-markdown": "9.0.1",
    "reactflow": "11.11.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "1.16.1",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.15.0",
    "@next/bundle-analyzer": "15.0.3",
    "@tanstack/eslint-plugin-query": "5.60.1",
    "@tanstack/react-query-devtools": "5.60.6",
    "@types/eslint__eslintrc": "2.1.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/utils": "8.15.0",
    "autoprefixer": "10.4.20",
    "bun-types": "1.1.34",
    "drizzle-kit": "0.28.1",
    "eslint": "9.14.0",
    "eslint-config-next": "15.0.3",
    "eslint-config-turbo": "2.3.0",
    "globals": "15.12.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "postcss": "8.4.49",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "posthog-js": "1.187.0",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "sort-package-json": "2.11.0",
    "tailwindcss": "3.4.15",
    "turbo": "2.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vercel": "39.0.5"
  },
  "packageManager": "bun@1.1.34"
}
