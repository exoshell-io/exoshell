{
  "name": "@exoshell/root",
  "private": true,
  "type": "module",
  "workspaces": [
    ".github/scripts",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo run build:",
    "ci": "bun run format:check && bun run lint && bun run test",
    "clean": "turbo run clean",
    "format": "prettier -w . ; sort-package-json",
    "format:check": "prettier --check . && sort-package-json --check && cargo fmt --check",
    "gen:types": "cargo test -p model export_bindings",
    "lint": "turbo run lint: && cargo clippy",
    "prepare": "husky install",
    "test": "turbo run test && cargo test --locked",
    "update": "bun x npm-check-updates -ui -ws --root"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@mantine/code-highlight": "7.10.2",
    "@mantine/core": "7.10.2",
    "@mantine/form": "7.10.2",
    "@mantine/hooks": "7.10.2",
    "@mantine/modals": "7.10.2",
    "@mantine/notifications": "7.10.2",
    "@mantine/nprogress": "7.10.2",
    "@mantine/spotlight": "7.10.2",
    "@tanstack/query-core": "5.87.1",
    "@tanstack/react-query": "5.87.1",
    "@vercel/postgres": "0.10.0",
    "allotment": "1.20.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.44.5",
    "jotai": "2.14.0",
    "mantine-contextmenu": "7.10.2",
    "next": "14.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "reactflow": "11.11.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.4",
    "@tanstack/eslint-plugin-query": "5.86.0",
    "@tanstack/react-query-devtools": "5.87.3",
    "@types/node": "24.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "autoprefixer": "10.4.21",
    "bun-types": "1.2.21",
    "drizzle-kit": "0.31.4",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.4",
    "eslint-config-turbo": "2.5.6",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "posthog-js": "1.262.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "sort-package-json": "3.4.0",
    "tailwindcss": "3.4.4",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vercel": "47.0.7"
  },
  "packageManager": "bun@1.2.21"
}
