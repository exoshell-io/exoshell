{
  "name": "@exoshell/root",
  "private": true,
  "type": "module",
  "workspaces": [
    ".github/scripts",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo run build:",
    "ci": "bun run format:check && bun run lint && bun run test",
    "clean": "turbo run clean",
    "format": "prettier -w . ; sort-package-json",
    "format:check": "prettier --check . && sort-package-json --check && cargo fmt --check",
    "gen:types": "rm -rf libs/model/types/ && cargo test -p model export_bindings",
    "lint": "turbo run lint: && cargo clippy",
    "prepare": "husky",
    "test": "turbo run test && cargo test --locked",
    "update": "bun x npm-check-updates -ui -ws --root"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true
  },
  "dependencies": {
    "@hello-pangea/dnd": "17.0.0",
    "@mantine/code-highlight": "7.12.2",
    "@mantine/core": "7.12.2",
    "@mantine/dropzone": "7.12.2",
    "@mantine/form": "7.12.2",
    "@mantine/hooks": "7.12.2",
    "@mantine/modals": "7.12.2",
    "@mantine/notifications": "7.12.2",
    "@mantine/nprogress": "7.12.2",
    "@mantine/spotlight": "7.12.2",
    "@monaco-editor/react": "4.6.0",
    "@tanstack/query-core": "5.56.2",
    "@tanstack/react-query": "5.56.2",
    "@vercel/postgres": "0.10.0",
    "allotment": "1.20.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.34.1",
    "jotai": "2.10.0",
    "mantine-contextmenu": "7.12.2",
    "next": "14.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "react-markdown": "9.0.1",
    "reactflow": "11.11.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.13",
    "@tanstack/eslint-plugin-query": "5.57.2",
    "@tanstack/react-query-devtools": "5.56.2",
    "@types/node": "22.6.1",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "autoprefixer": "10.4.20",
    "bun-types": "1.1.29",
    "drizzle-kit": "0.25.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.13",
    "eslint-config-turbo": "2.1.2",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "postcss": "8.4.47",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "7.0.1",
    "posthog-js": "1.164.3",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "sort-package-json": "2.10.1",
    "tailwindcss": "3.4.13",
    "turbo": "2.1.2",
    "typescript": "5.6.2",
    "vercel": "37.5.4"
  },
  "packageManager": "bun@1.1.29"
}
